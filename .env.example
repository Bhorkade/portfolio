# Frontend Environment Variables Template
# In local development, the Vite proxy handles /api -> http://localhost:5000 automatically.
# In production (e.g. deployed to Vercel), set VITE_API_URL to your deployed Express backend URL.
# Example: VITE_API_URL=https://your-portfolio-backend.onrender.com
VITE_API_URL=http://localhost:5000
